load("@rules_cc//cc:defs.bzl", "cc_test")

cc_test(
    name = "test_chatbot",
    srcs = ["test_chatbot.cc"],
    deps = [
        "//:chatbot_lib",
        "@googletest//:gtest_main",
    ],
)

# End-to-end test: pipeline tests (no network) + SIP answer test (optional).
#
# PipelineTest: injects fake Services into Session directly — runs always.
# SipAnswerTest: launches sloperator as a subprocess — skipped unless
#   SLOPERATOR_BIN is set (or the binary is found in TEST_SRCDIR/_main/).
#
# Run with:
#   bazel test //tests:test_e2e_sip
#
# exclusive: binds fixed localhost ports for SipAnswerTest.
# local: needs fork/exec for the subprocess test.
cc_test(
    name = "test_e2e_sip",
    srcs = ["test_e2e_sip.cc"],
    data = ["//:sloperator"],
    tags = ["exclusive", "local"],
    linkopts = [
        "-ldl",
        "-lpthread",
        "-lm",
        "-lrt",
    ],
    deps = [
        "//:bot_core",
        "@googletest//:gtest_main",
    ],
)

# In-process models (sherpa-onnx) against real model files.
cc_test(
    name = "test_sherpa",
    srcs = ["test_sherpa.cc"],
    data = [
        "@moonshine_base_en//:model",
        "@moonshine_base_en//:test_wavs/0.wav",
        "@moonshine_base_en//:tokens.txt",
        "@piper_lessac//:model",
        "@piper_lessac//:tokens.txt",
        "@silero_vad//file",
        "@silero_vad_wav//file",
    ],
    env = {
        "TTS_MODEL": "$(rlocationpath @piper_lessac//:tokens.txt)",
        "STT_MODEL": "$(rlocationpath @moonshine_base_en//:tokens.txt)",
        "STT_WAV": "$(rlocationpath @moonshine_base_en//:test_wavs/0.wav)",
        "VAD_MODEL": "$(rlocationpath @silero_vad//file)",
        "SPEECH_WAV": "$(rlocationpath @silero_vad_wav//file)",
    },
    deps = [
        "//:bot_core",
        "@googletest//:gtest_main",
    ],
)

# Same ASR test on Parakeet (650 MB download): bazel test //tests:test_sherpa_parakeet
cc_test(
    name = "test_sherpa_parakeet",
    srcs = ["test_sherpa.cc"],
    args = ["--gtest_filter=SherpaAsr.*"],
    data = [
        "@moonshine_base_en//:test_wavs/0.wav",
        "@parakeet_tdt_v2//:model",
        "@parakeet_tdt_v2//:tokens.txt",
    ],
    env = {
        "STT_MODEL": "$(rlocationpath @parakeet_tdt_v2//:tokens.txt)",
        "STT_WAV": "$(rlocationpath @moonshine_base_en//:test_wavs/0.wav)",
    },
    tags = ["manual"],
    deps = [
        "//:bot_core",
        "@googletest//:gtest_main",
    ],
)

# Kokoro TTS round trip (130 MB download): bazel test //tests:test_sherpa_kokoro
cc_test(
    name = "test_sherpa_kokoro",
    srcs = ["test_sherpa.cc"],
    args = ["--gtest_filter=SherpaTts.*"],
    data = [
        "@kokoro_en//:model",
        "@kokoro_en//:tokens.txt",
        "@moonshine_base_en//:model",
        "@moonshine_base_en//:tokens.txt",
    ],
    env = {
        "STT_MODEL": "$(rlocationpath @moonshine_base_en//:tokens.txt)",
        "TTS_MODEL": "$(rlocationpath @kokoro_en//:tokens.txt)",
    },
    tags = ["manual"],
    deps = [
        "//:bot_core",
        "@googletest//:gtest_main",
    ],
)
