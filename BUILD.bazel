load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load", "oci_push")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files", "strip_prefix")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

exports_files(["bot_config.yaml"])

# ── Shared header-only library ────────────────────────────────────────────────

cc_library(
    name = "chatbot_lib",
    hdrs = ["chatbot_lib.h"],
    visibility = ["//visibility:public"],
)

# ── Bot core library ─────────────────────────────────────────────────────────
#
# All chatbot logic: Wyoming/Ollama helpers, audio cues, Session, BotAudioPort,
# BotCall, BotAccount, MakeRealServices().  Linked by the binary and the test.

cc_library(
    name = "bot_core",
    srcs = ["bot_core.cc", "sherpa.cc"],
    hdrs = ["bot_core.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":chatbot_lib",
        "@abseil-cpp//absl/log",
        "@cpp-httplib//:httplib",
        "@nlohmann_json//:json",
        "@pjsip",
        "@sherpa_onnx",
        "@yaml-cpp//:yaml-cpp",
    ],
)

# ── sloperator binary ────────────────────────────────────────────────────────

cc_binary(
    name = "sloperator",
    srcs = ["main.cc"],
    linkopts = [
        "-ldl",
        "-lpthread",
        "-lm",
        "-lrt",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":bot_core",
        "@abseil-cpp//absl/flags:flag",
        "@abseil-cpp//absl/flags:parse",
        "@abseil-cpp//absl/flags:usage",
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/log:globals",
        "@abseil-cpp//absl/log:initialize",
        "@pjsip",
        "@yaml-cpp//:yaml-cpp",
    ],
)

# ── OCI container image ───────────────────────────────────────────────────────

# Binary + sherpa/onnxruntime libs + default models (see bot_config.yaml):
#   /models/silero_vad.onnx  /models/moonshine  /models/piper

pkg_tar(
    name = "sloperator_layer",
    srcs = [":sloperator"],
    package_dir = "/usr/local/bin",
)

pkg_files(
    name = "libs",
    srcs = ["@sherpa_onnx//:libs"],
    prefix = "usr/local",
    strip_prefix = strip_prefix.from_pkg(),
)

[pkg_files(
    name = "model_" + d,
    srcs = [src],
    prefix = "models" + ("/" + d if d != "vad" else ""),
    strip_prefix = strip_prefix.from_pkg(),
) for d, src in [
    ("vad", "@silero_vad//file"),
    ("moonshine", "@moonshine_base_en//:model"),
    ("piper", "@piper_lessac//:model"),
]]

# Separate layers: models and libs change rarely, so pushes stay small.
pkg_tar(name = "libs_layer", srcs = [":libs"])

pkg_tar(name = "models_layer", srcs = [":model_vad", ":model_moonshine", ":model_piper"])

oci_image(
    name = "image",
    base = "@distroless_cc",
    entrypoint = ["/usr/local/bin/sloperator"],
    env = {"LD_LIBRARY_PATH": "/usr/local/lib"},
    exposed_ports = ["5060/udp"],
    tars = [":models_layer", ":libs_layer", ":sloperator_layer"],
)

# bazel run //:image_load  (docker), or podman load -i $(bazel cquery --output=files //:image_load)
oci_load(
    name = "image_load",
    image = ":image",
    repo_tags = ["sloperator:dev"],
)

# Use --@//:repository=ghcr.io/owner/repo to override at push time.
oci_push(
    name = "image_push",
    image = ":image",
    remote_tags = ["latest"],
    repository = "ghcr.io/placeholder",
)
