module(
    name = "sloperator",
)

bazel_dep(name = "abseil-cpp", version = "20260817.0")
bazel_dep(name = "libuuid", version = "2.41.2.bcr.1")
single_version_override(
    module_name = "libuuid",
    patch_strip = 1,
    patches = ["//third_party/libuuid:fix_strptime.patch"],
)

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "googletest", version = "1.18.0.bcr.1")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.27")
bazel_dep(name = "rules_foreign_cc", version = "0.17.0")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "cpp-httplib", version = "0.46.0")
bazel_dep(name = "yaml-cpp", version = "0.9.0.bcr.1")
bazel_dep(name = "nlohmann_json", version = "3.12.0.bcr.2")

# ── rules_foreign_cc toolchain: use system tools ──────────────────────────────
register_toolchains(
    "@rules_foreign_cc//toolchains:preinstalled_make_toolchain",
    "@rules_foreign_cc//toolchains:preinstalled_automake_toolchain",
    "@rules_foreign_cc//toolchains:preinstalled_autoconf_toolchain",
    "@rules_foreign_cc//toolchains:preinstalled_m4_toolchain",
    "@rules_foreign_cc//toolchains:preinstalled_pkgconfig_toolchain",
)

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "distroless_cc",
    digest = "sha256:329e54034ce498f9c6b345044e8f530c6691f99e94a92446f68c0adf9baa8464",
    image = "gcr.io/distroless/cc-debian12",
    platforms = ["linux/amd64"],
)
use_repo(oci, "distroless_cc", "distroless_cc_linux_amd64")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "pjsip",
    build_file = "@//:third_party/pjsip/pjsip.BUILD",
    sha256 = "065fe06c06788d97c35f563796d59f00ce52fe9558a52d7b490a042a966facce",
    strip_prefix = "pjproject-2.17",
    urls = ["https://github.com/pjsip/pjproject/archive/refs/tags/2.17.tar.gz"],
)
